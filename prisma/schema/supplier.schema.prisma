model Supplier {
  id            String    @id @default(uuid())
  name          String
  contact       String
  email         String    @unique
  category      String
  reliability   Float     @default(5.0) // 1 to 5 rating
  basePrice     Float?
  deliveryTime  String?   // e.g., "3-5 Days"
  
  products      Product[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}